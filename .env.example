# This shows what environment variables the project needs (without real values)

# Providers
# LLM_PROVIDER: ollama (local) | groq | gemini
# LLM_FALLBACK_PROVIDER: optional, used when the primary provider fails or is rate-limited
# EMBEDDINGS_PROVIDER: ollama (local) | fastembed (in-process, used by the hosted demo)
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=
EMBEDDINGS_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
SEED_SAMPLE_DOCUMENTS=false

# Authentication (shared by the API and the Streamlit UI)
API_KEY=change-me

# Application
LOG_LEVEL=INFO
DEBUG=false
